# Copy to .env; set your own publicly reachable HTTPS origin and content DNS suffix.
PUBLISH_DATA_DIR=/data
PUBLISH_BASE_URL=https://publish.example.com
PUBLISH_CONTENT_DOMAIN=publish.example.com
PUBLISH_STORAGE_BUDGET_BYTES=21474836480
PUBLISH_REMOTE_MCP=false
# Optional provider file inputs: exact trusted HTTPS source hosts, empty until verified.
PUBLISH_MCP_FILE_HOSTS=
# Optional public HTTPS GitHub repository, used when the project URL is empty.
PUBLISH_SOURCE_URL=
# Optional public HTTPS project site, linked from the guest homepage, sign-in and password pages.
PUBLISH_PROJECT_URL=
# Optional session overrides use the defaults in src/minder_publish/defaults.json:
# PUBLISH_OWNER_SESSION_IDLE_DAYS=
# PUBLISH_OWNER_SESSION_ABSOLUTE_DAYS=
# PUBLISH_OWNER_SESSION_REFRESH_SECONDS=
# PUBLISH_OWNER_RECENT_AUTH_SECONDS=
# Bootstrap creates /data/server.secret; do not add a default password or token here.
# Optional override for an external secret manager: PUBLISH_SECRET (at least 32 random bytes).
# Optional reverse-proxy body ceiling. The default includes the maximum upload
# payload and its multipart allowance. Application limits remain authoritative.
# PUBLISH_PROXY_MAX_BODY_BYTES=
# Compose sets * only inside its dedicated app/proxy network, with no app host port.
