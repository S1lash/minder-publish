worker_processes 1;
pid /tmp/nginx.pid;
# Keep routine request/query context out of the unstructured nginx error log.
error_log /dev/stderr crit;

events { worker_connections 1024; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    resolver 127.0.0.11 valid=10s ipv6=off;
    server_tokens off;
    log_format bounded '$time_iso8601 $remote_addr $host $request_method $uri '
                       '$status $body_bytes_sent $request_time';
    access_log /dev/stdout bounded;
    client_body_temp_path /tmp/client-body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    client_max_body_size @@MAX_BODY_BYTES@@;
    client_body_timeout 120s;
    client_header_timeout 15s;
    keepalive_timeout 30s;
    send_timeout 120s;

    server {
        listen 8080 default_server;
        server_name _;
        return 444;
    }
    server {
        listen 8080;
        server_name @@CONTROL_HOST@@ *.@@CONTENT_DOMAIN@@;
        return 308 https://$host$request_uri;
    }
    server {
        listen 8443 ssl default_server;
        server_name _;
        ssl_certificate /etc/nginx/tls/fullchain.pem;
        ssl_certificate_key /etc/nginx/tls/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        return 444;
    }
    server {
        listen 8443 ssl;
        server_name @@CONTROL_HOST@@ *.@@CONTENT_DOMAIN@@;
        ssl_certificate /etc/nginx/tls/fullchain.pem;
        ssl_certificate_key /etc/nginx/tls/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_tickets off;
        add_header Strict-Transport-Security "max-age=31536000" always;

        location / {
            set $publish_backend app:8080;
            proxy_pass http://$publish_backend;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Service-Worker $http_service_worker;
            proxy_set_header Sec-Fetch-Dest $http_sec_fetch_dest;
            proxy_set_header Connection "";
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_cache off;
            proxy_max_temp_file_size 0;
            proxy_next_upstream off;
            proxy_connect_timeout 5s;
            proxy_send_timeout 120s;
            proxy_read_timeout 3600s;
        }
    }
}
